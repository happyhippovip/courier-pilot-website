{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CourierReceipt",
  "type": "object",
  "required": [
    "receipt_id",
    "item_id",
    "timestamp",
    "status",
    "fingerprint",
    "tests_passed"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^rcpt-[0-9a-fA-F-]{8,}$"
    },
    "item_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "BLOCKED"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 digest of modified trees and output artifacts"
    },
    "tests_passed": {
      "type": "integer",
      "minimum": 0
    },
    "execution_duration_ms": {
      "type": "number"
    }
  }
}
