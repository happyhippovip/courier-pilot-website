# Courier Symphony — Apache config for STRATO webhosting.
# build.py copies this file to dist/.htaccess. Upload it together with the site.

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- HTTPS + canonical host (couriersymphony.de without www) ---
# Alternative without .htaccess: STRATO login -> Domains -> SSL -> "SSL erzwingen" (301).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # http -> https (STRATO FAQ pattern)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://couriersymphony.de%{REQUEST_URI} [R=301,L]
  # www -> apex
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://couriersymphony.de%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  # Enable only after HTTPS works for apex AND www (STRATO FAQ: requires valid SSL):
  # Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml image/svg+xml
</IfModule>
